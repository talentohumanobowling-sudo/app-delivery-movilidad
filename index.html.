<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LLEGANDO - Red Integral de Movilidad y Logística</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Leaflet CSS y JS para Mapas Interactivos -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- FontAwesome para Iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        #map { height: 350px; width: 100%; border-radius: 0.75rem; z-index: 10; }
        .transition-sidebar { transition: transform 0.3s ease-in-out; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased min-h-screen flex flex-col pb-24">

    <!-- Notificación Toast Flotante -->
    <div id="toast" class="fixed top-5 right-5 z-50 transform translate-x-full transition-transform duration-300 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center space-x-3">
        <i id="toast-icon" class="fa-solid fa-circle-check text-green-400 text-xl"></i>
        <span id="toast-message" class="text-sm font-medium">Acción realizada con éxito</span>
    </div>

    <!-- Barra Superior -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <button onclick="toggleSidebar()" class="text-gray-600 hover:text-red-600 focus:outline-none p-2 rounded-lg hover:bg-gray-100 transition">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
                <div class="flex items-center space-x-2">
                    <div class="bg-red-600 text-white p-2 rounded-lg shadow-md">
                        <i class="fa-solid fa-route"></i>
                    </div>
                    <span class="font-bold text-lg tracking-wide text-gray-900">LLEGANDO</span>
                </div>
            </div>

            <div class="flex items-center space-x-4">
                <div class="hidden sm:flex flex-col text-right cursor-pointer" onclick="cambiarTasaBCV()" title="Clic para actualizar tasa">
                    <span class="text-xs text-gray-400 font-semibold uppercase">Tasa BCV Oficial</span>
                    <span class="text-sm font-bold text-red-600" id="bcv-rate-display">Bs. 884.75</span>
                </div>
                <div class="flex items-center space-x-2 bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
                    <span id="current-portal-badge" class="text-xs font-semibold text-gray-700">Catálogo & Logística</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Menú Lateral Desplegable (Sidebar) -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-80 bg-white border-r border-gray-200 transform -translate-x-full transition-sidebar shadow-2xl flex flex-col justify-between">
        <div class="p-6 space-y-6 overflow-y-auto">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Menú Principal</span>
                <button onclick="toggleSidebar()" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <nav class="space-y-1">
                <button onclick="cambiarVista('catalogo'); toggleSidebar();" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-700 hover:bg-red-50 hover:text-red-600 transition">
                    <i class="fa-solid fa-store w-5"></i>
                    <span>Catálogo de Productos</span>
                </button>
                <button onclick="cambiarVista('nuevo'); toggleSidebar();" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-700 hover:bg-red-50 hover:text-red-600 transition">
                    <i class="fa-solid fa-circle-plus w-5"></i>
                    <span>Registrar Producto</span>
                </button>
                <button onclick="cambiarVista('mapa'); toggleSidebar();" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-700 hover:bg-red-50 hover:text-red-600 transition">
                    <i class="fa-solid fa-map-location-dot w-5"></i>
                    <span>Rutas y Mapa Logístico</span>
                </button>
                <button onclick="cambiarVista('carrito'); toggleSidebar();" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-700 hover:bg-red-50 hover:text-red-600 transition">
                    <i class="fa-solid fa-cart-shopping w-5"></i>
                    <span>Carrito de Pedidos</span>
                </button>
            </nav>
        </div>
        <div class="p-4 border-t border-gray-100 text-center">
            <button onclick="cambiarTasaBCV()" class="w-full bg-gray-100 text-gray-700 py-2 rounded-lg text-xs font-bold hover:bg-gray-200 transition">
                <i class="fa-solid fa-pen-to-square mr-1"></i> Modificar Tasa BCV
            </button>
        </div>
    </aside>

    <!-- Fondo oscuro al abrir el menú -->
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/40 z-30 hidden transition-opacity"></div>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 space-y-4">

        <!-- VISTA 1: CATÁLOGO DE PRODUCTOS -->
        <div id="view-catalogo" class="space-y-4">
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-400"></i>
                <input type="text" id="search-input" oninput="renderizarCatalogo()" placeholder="Buscar productos o servicios..." class="w-full pl-11 pr-4 py-3 bg-white rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 shadow-sm">
            </div>
            <div id="catalogo-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Se inyecta dinámicamente -->
            </div>
        </div>

        <!-- VISTA 2: NUEVO PRODUCTO -->
        <div id="view-nuevo" class="hidden bg-white p-6 rounded-2xl shadow-sm border border-gray-200 space-y-4 max-w-lg mx-auto">
            <h2 class="font-bold text-gray-800 text-lg border-b pb-3 flex items-center">
                <i class="fa-solid fa-plus-circle text-red-600 mr-2"></i> Registrar Nuevo Producto
            </h2>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Nombre del Producto / Servicio</label>
                <input type="text" id="new-name" placeholder="Ej: Envío Express / Insumo" class="w-full p-3 border rounded-xl text-sm focus:ring-2 focus:ring-red-500 outline-none">
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Precio Unitario en USD ($)</label>
                <input type="number" step="0.01" id="new-price" placeholder="0.00" class="w-full p-3 border rounded-xl text-sm focus:ring-2 focus:ring-red-500 outline-none">
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">URL de la Imagen (Opcional)</label>
                <input type="text" id="new-img" placeholder="https://..." class="w-full p-3 border rounded-xl text-sm focus:ring-2 focus:ring-red-500 outline-none">
            </div>
            <button onclick="guardarProducto()" class="w-full bg-red-600 text-white py-3 rounded-xl font-bold text-sm shadow-md hover:bg-red-700 transition">
                Guardar y Publicar
            </button>
        </div>

        <!-- VISTA 3: MAPA Y LOGÍSTICA -->
        <div id="view-mapa" class="hidden bg-white p-6 rounded-2xl shadow-sm border border-gray-200 space-y-4">
            <h2 class="font-bold text-gray-800 text-lg flex items-center">
                <i class="fa-solid fa-map-location-dot text-red-600 mr-2"></i> Mapa y Cobertura Logística
            </h2>
            <p class="text-xs text-gray-500">Visualiza puntos de despacho y rutas activas en tiempo real.</p>
            <div id="map"></div>
        </div>

        <!-- VISTA 4: CARRITO Y PEDIDOS -->
        <div id="view-carrito" class="hidden space-y-4 max-w-lg mx-auto">
            <h2 class="font-bold text-gray-800 text-lg flex items-center">
                <i class="fa-solid fa-cart-shopping text-red-600 mr-2"></i> Detalle del Pedido
            </h2>
            <div id="cart-list" class="space-y-2">
                <!-- Se llena dinámicamente -->
            </div>
            <div class="bg-white p-5 rounded-2xl border border-gray-200 space-y-3 shadow-sm">
                <div class="flex justify-between font-bold text-gray-700 text-sm">
                    <span>Total USD:</span>
                    <span id="cart-total-usd">$0.00</span>
                </div>
                <div class="flex justify-between font-extrabold text-red-600 text-lg border-t pt-2">
                    <span>Total Bolívares (BCV):</span>
                    <span id="cart-total-bs">Bs. 0.00</span>
                </div>
                <button onclick="enviarWhatsApp()" class="w-full bg-green-600 text-white py-3.5 rounded-xl font-bold text-sm shadow-md hover:bg-green-700 flex items-center justify-center space-x-2 transition">
                    <i class="fa-brands fa-whatsapp text-lg"></i>
                    <span>Procesar Pedido por WhatsApp</span>
                </button>
            </div>
        </div>

    </main>

    <!-- NAVEGACIÓN INFERIOR FIJA -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 flex justify-around py-3 shadow-lg z-30 max-w-4xl mx-auto">
        <button onclick="cambiarVista('catalogo')" id="nav-catalogo" class="flex flex-col items-center text-red-600 font-medium">
            <i class="fa-solid fa-store text-lg"></i>
            <span class="text-[10px] mt-1">Catálogo</span>
        </button>
        <button onclick="cambiarVista('nuevo')" id="nav-nuevo" class="flex flex-col items-center text-gray-400 font-medium">
            <i class="fa-solid fa-circle-plus text-lg"></i>
            <span class="text-[10px] mt-1">Nuevo</span>
        </button>
        <button onclick="cambiarVista('mapa')" id="nav-mapa" class="flex flex-col items-center text-gray-400 font-medium">
            <i class="fa-solid fa-map text-lg"></i>
            <span class="text-[10px] mt-1">Mapa</span>
        </button>
        <button onclick="cambiarVista('carrito')" id="nav-carrito" class="flex flex-col items-center text-gray-400 font-medium relative">
            <i class="fa-solid fa-cart-shopping text-lg"></i>
            <span class="text-[10px] mt-1">Carrito</span>
            <span id="cart-badge" class="absolute -top-1 right-1 bg-red-600 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full hidden">0</span>
        </button>
    </nav>

    <!-- Script de Lógica de la App -->
    <script>
        let tasaBCV = parseFloat(localStorage.getItem('llegando_tasa')) || 884.75;
        let productos = JSON.parse(localStorage.getItem('llegando_prods')) || [
            { id: 1, nombre: 'Servicio de Envíos Express', precio: 10.00, img: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=300&auto=format&fit=crop&q=80' },
            { id: 2, nombre: 'Paquete Logístico Standard', precio: 25.00, img: 'https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?w=300&auto=format&fit=crop&q=80' }
        ];
        let carrito = {};
        let mapInitialized = false;
        let map;

        document.getElementById('bcv-rate-display').innerText = `Bs. ${tasaBCV.toFixed(2)}`;

        function guardarDatos() {
            localStorage.setItem('llegando_prods', JSON.stringify(productos));
            localStorage.setItem('llegando_tasa', tasaBCV);
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

        function cambiarVista(vista) {
            ['catalogo', 'nuevo', 'mapa', 'carrito'].forEach(v => {
                document.getElementById(`view-${v}`).classList.add('hidden');
                const navBtn = document.getElementById(`nav-${v}`);
                if(navBtn) navBtn.className = 'flex flex-col items-center text-gray-400 font-medium';
            });
            document.getElementById(`view-${vista}`).classList.remove('hidden');
            const activeNav = document.getElementById(`nav-${vista}`);
            if(activeNav) activeNav.className = 'flex flex-col items-center text-red-600 font-medium';

            if (vista === 'mapa' && !mapInitialized) {
                setTimeout(() => {
                    map = L.map('map').setView([10.1581, -66.8656], 13); // Charallave / zona central por defecto
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(map);
                    L.marker([10.1581, -66.8656]).addTo(map)
                        .bindPopup('<b>LLEGANDO Hub Central</b><br/>Operaciones de Logística.')
                        .openPopup();
                    mapInitialized = true;
                }, 200);
            }
        }

        function cambiarTasaBCV() {
            const nueva = prompt("Ingrese la nueva tasa oficial BCV (Bs. por $):", tasaBCV);
            if (nueva && !isNaN(nueva) && nueva > 0) {
                tasaBCV = parseFloat(nueva);
                document.getElementById('bcv-rate-display').innerText = `Bs. ${tasaBCV.toFixed(2)}`;
                guardarDatos();
                renderizarCatalogo();
                mostrarToast("Tasa BCV actualizada correctamente");
            }
        }

        function renderizarCatalogo() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const grid = document.getElementById('catalogo-grid');
            grid.innerHTML = '';

            productos.filter(p => p.nombre.toLowerCase().includes(query)).forEach(p => {
                const bs = (p.precio * tasaBCV).toFixed(2);
                grid.innerHTML += `
                    <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm flex space-x-4 items-center">
                        <img src="${p.img}" class="w-20 h-20 object-cover rounded-xl bg-gray-100" onerror="this.src='https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=300&auto=format&fit=crop&q=80'">
                        <div class="flex-1">
                            <h3 class="font-bold text-gray-800 text-sm">${p.nombre}</h3>
                            <div class="mt-1">
                                <span class="text-red-600 font-extrabold text-base">$${p.precio.toFixed(2)}</span>
                                <span class="block text-xs text-gray-500 font-semibold">Bs. ${bs}</span>
                            </div>
                        </div>
                        <button onclick="agregarCarrito(${p.id})" class="bg-red-600 text-white p-3 rounded-xl shadow hover:bg-red-700 transition">
                            <i class="fa-solid fa-cart-plus"></i>
                        </button>
                    </div>
                `;
            });
            actualizarCarritoVista();
        }

        function guardarProducto() {
            const nombre = document.getElementById('new-name').value;
            const precio = parseFloat(document.getElementById('new-price').value);
            const img = document.getElementById('new-img').value || 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=300&auto=format&fit=crop&q=80';

            if (!nombre || isNaN(precio) || precio <= 0) {
                alert("Por favor ingrese un nombre y precio válido.");
                return;
            }

            productos.push({ id: Date.now(), nombre, precio, img });
            guardarDatos();
            document.getElementById('new-name').value = '';
            document.getElementById('new-price').value = '';
            document.getElementById('new-img').value = '';
            cambiarVista('catalogo');
            renderizarCatalogo();
            mostrarToast("Producto registrado exitosamente");
        }

        function agregarCarrito(id) {
            carrito[id] = (carrito[id] || 0) + 1;
            renderizarCatalogo();
            mostrarToast("Producto agregado al carrito");
        }

        function actualizarCarritoVista() {
            const container = document.getElementById('cart-list');
            container.innerHTML = '';
            let totalUsd = 0;
            let totalCount = 0;

            Object.keys(carrito).forEach(id => {
                const prod = productos.find(p => p.id == id);
                if (prod) {
                    const cant = carrito[id];
                    const subUsd = prod.precio * cant;
                    totalUsd += subUsd;
                    totalCount += cant;
                    container.innerHTML += `
                        <div class="bg-white p-4 rounded-xl border border-gray-200 flex justify-between items-center text-sm shadow-sm">
                            <div>
                                <p class="font-bold text-gray-800">${prod.nombre}</p>
                                <p class="text-xs text-gray-500">$${prod.precio.toFixed(2)} x ${cant}</p>
                            </div>
                            <span class="font-extrabold text-red-600">$${subUsd.toFixed(2)}</span>
                        </div>
                    `;
                }
            });

            const totalBs = totalUsd * tasaBCV;
            document.getElementById('cart-total-usd').innerText = `$${totalUsd.toFixed(2)}`;
            document.getElementById('cart-total-bs').innerText = `Bs. ${totalBs.toFixed(2)}`;

            const badge = document.getElementById('cart-badge');
            if (totalCount > 0) {
                badge.innerText = totalCount;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function enviarWhatsApp() {
            let msg = "¡Hola LLEGANDO! Deseo confirmar el siguiente pedido:%0A%0A";
            let totalUsd = 0;

            Object.keys(carrito).forEach(id => {
                const prod = productos.find(p => p.id == id);
                if (prod) {
                    const cant = carrito[id];
                    const subUsd = prod.precio * cant;
                    totalUsd += subUsd;
                    msg += `• ${prod.nombre} x${cant} - $${subUsd.toFixed(2)}%0A`;
                }
            });

            const totalBs = totalUsd * tasaBCV;
            msg += `%0A*Total USD:* $${totalUsd.toFixed(2)}`;
            msg += `%0A*Total BS (Tasa BCV ${tasaBCV}):* Bs. ${totalBs.toFixed(2)}`;

            window.open(`https://wa.me/?text=${msg}`, '_blank');
        }

        function mostrarToast(mensaje) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = mensaje;
            toast.classList.remove('translate-x-full');
            setTimeout(() => {
                toast.classList.add('translate-x-full');
            }, 3000);
        }

        renderizarCatalogo();
    </script>
</body>
</html>
